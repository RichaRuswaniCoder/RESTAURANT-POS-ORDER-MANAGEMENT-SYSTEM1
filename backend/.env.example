PORT=5000
# Copy this file to .env and replace every placeholder locally. Never commit .env.
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/<DATABASE_NAME>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
FRONTEND_ORIGINS=http://localhost:3000
BILLING_TAX_RATE=5
MAX_DISCOUNT_PERCENT=10
ADMIN_NAME=Restaurant Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_at_least_12_chars
STAFF_NAME=Restaurant Staff
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=replace_with_a_strong_password_at_least_12_chars
